{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "ortak hook session-start" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "ortak hook pre-edit" }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "ortak hook pre-bash" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "ortak hook post-edit" }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "ortak hook post-bash" }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "ortak hook prompt-context" }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "ortak hook session-end" }]
      }
    ]
  }
}
